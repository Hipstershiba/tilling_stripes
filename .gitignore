# ==============================================================================
# Tiling Stripes Studio — Git Ignore
# ==============================================================================

# Vendor / Reference gems
gems/

# Asset uploads and temporary directories
uploads/
assets/uploads/
tmp/uploads/
tmp/
temp/
*.tiles-backup.json

# Local artifacts directory (purely local dumps, test outputs and scratch scripts)
_local/*
!_local/README.md

# Headless browser profiles and execution traces
.tmp-edge*
*.log

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Python Virtual Environments & Bytecode
.venv/
venv/
env/
ENV/
*.venv*
__pycache__/
*.py[cod]
*$py.class

# Graphify Knowledge Graph artifacts & local caches
graphify-out/
.graphify/

# Node / Package dependencies
node_modules/
npm-debug.log*

# Local AI / Tooling configurations
.codex/

# Generated visual evidence and audit execution artifacts
*.png
/docs/ux/evidencias/
/docs/relatorios/assets/
